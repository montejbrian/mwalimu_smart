# MwalimuSmart Web — .env template
# Copy to .env in project root. Never commit .env.

# ── REQUIRED: LLM APIs ────────────────────────────────────────────────────────
# OpenAI (embeddings): https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Anthropic (lesson scripts): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
# Google Gemini (Manim codegen + voice NLU): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── REQUIRED: Google Cloud (Voice TTS + STT) ──────────────────────────────────
# Create service account, enable TTS + STT APIs, download JSON key
# Voice falls back to text-only if omitted
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json

# ── REQUIRED: Databases ───────────────────────────────────────────────────────
POSTGRES_DSN=postgresql://mwalimu:yourpassword@localhost:5432/mwalimusmart
TEST_DATABASE_URL=postgresql://mwalimu:yourpassword@localhost:5432/mwalimusmart_test
MONGODB_URI=mongodb://localhost:27017/mwalimusmart
REDIS_URL=redis://localhost:6379

# ──OPTIONAL: Feature Flags ────────────────────────────────────────────────────
FF_TIER1_VISUALS=true

# ── REQUIRED: Security ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=replace-with-64-char-random-hex
AUTH_REFRESH_SECRET=replace-with-another-64-char-random-hex

# ── REQUIRED for production ───────────────────────────────────────────────────
# Dev: http://localhost:5173,http://localhost:4000
# Prod: https://yourapp.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ── OPTIONAL: Paths ───────────────────────────────────────────────────────────
RENDERS_DIR=renders
KICD_DOCS_DIR=kicd_docs
KICD_PDFS_DIR=kicd_pdfs

# ── OPTIONAL: Server ──────────────────────────────────────────────────────────
PORT=4000
PYTHON_BIN=python3
LOG_LEVEL=INFO
NODE_ENV=development

# CDN_URL=https://cdn.yourdomain.com  # optional CDN for MP4 files

# Docker Compose only
DB_PASSWORD=mwalimupassword
