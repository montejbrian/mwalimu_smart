# ==========================================
# MWALIMU SMART - GLOBAL CONFIGURATION
# ==========================================

# --- AI API Keys ---
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Hugging Face token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# --- Google Cloud TTS ---
# Required for high-quality voiceovers in the main backend.
# 1. Create a service account in Google Cloud Console.
# 2. Enable "Cloud Text-to-Speech API".
# 3. Download the JSON key file.
# 4. Place it in the 'backend' folder and name it 'google-credentials.json'.
GOOGLE_APPLICATION_CREDENTIALS=google-credentials.json

# --- Backend Config ---
PORT=3001
FRONTEND_URL=http://localhost:5173
MANIM_SERVICE_URL=http://localhost:5000

# --- Manim Service Config ---
MANIM_PORT=5000
# Gemini model to use for Manim code generation
GEMINI_MODEL=gemini-1.5-flash
