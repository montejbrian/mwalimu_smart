{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "pythonPlatform": "Linux",
  "include": [
    "backend/manim-service"
  ],
  "exclude": ["**/__pycache__", "**/.git", "**/node_modules"],
  "typeCheckingMode": "basic",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "reportMissingTypeStubs": "none"
}
